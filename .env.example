# Copy to .env.local and fill in. Never commit real values.

# Anthropic — enables the LLM buyer agent (model claude-opus-5-5).
# If unset, Garnet runs a clearly labeled deterministic scripted planner.
ANTHROPIC_API_KEY=
GARNET_MODEL=claude-opus-5-5

# Neatlogs — enables trace export (workflowName "garnet").
NEATLOGS_API_KEY=
# NEATLOGS_ENDPOINT=https://eu.ingest.neatlogs.com

# Base Sepolia RPC used by the independent verifier.
# If unset, the public endpoint https://sepolia.base.org is used.
BASE_SEPOLIA_RPC_URL=

# Verification source: "rpc" (default) or "fixture" (offline, labeled).
GARNET_VERIFIER_MODE=rpc

# SQLite path for local persistent state.
GARNET_DB_PATH=./data/garnet.db
